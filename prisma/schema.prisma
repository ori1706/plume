// Plume — microblog showcase schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  LIKE
  FOLLOW
  REPLY
  REPOST
  QUOTE
}

model User {
  id           String @id @default(cuid())
  handle       String @unique
  email        String @unique
  passwordHash String
  name         String
  bio          String  @default("")
  avatarUrl    String  @default("")
  bannerUrl    String  @default("")
  location     String?
  createdAt    DateTime @default(now())

  posts                 Post[]
  likes                 Like[]
  reposts               Repost[]
  bookmarks             Bookmark[]
  following             Follow[]       @relation("UserFollowing")
  followers             Follow[]       @relation("UserFollowers")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
}

model Post {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String   @db.VarChar(560)
  parentId     String?
  parent       Post?    @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Post[]   @relation("PostReplies")
  quotedPostId String?
  quotedPost   Post?    @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes       Post[]   @relation("PostQuotes")
  createdAt    DateTime @default(now())

  media         PostMedia[]
  likes         Like[]
  reposts       Repost[]
  bookmarks     Bookmark[]
  postHashtags  PostHashtag[]
  notifications Notification[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([parentId, createdAt(sort: Asc)])
  @@index([createdAt(sort: Desc)])
}

model PostMedia {
  id        String @id @default(cuid())
  postId    String
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  width     Int?
  height    Int?
  sortOrder Int    @default(0)
}

model Like {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
}

model Repost {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
}

model Follow {
  followerId String
  followeeId String
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@index([followerId])
}

model Bookmark {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Hashtag {
  id    String @id @default(cuid())
  tag   String @unique
  count Int    @default(0)

  posts PostHashtag[]
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}
